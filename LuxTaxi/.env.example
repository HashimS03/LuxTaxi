# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# The email address that receives booking requests
OWNER_EMAIL=your_email@example.com

# Stripe (https://dashboard.stripe.com/apikeys) — used for "Pay Now" bookings.
# Use the sk_test_/whsec_test_ values while testing, sk_live_/whsec_ once you go live.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# From the Stripe CLI (`stripe listen`) while developing, or from the webhook
# endpoint you create in the Stripe Dashboard pointing to /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

# Google Maps Platform (https://console.cloud.google.com/google/maps-apis) —
# used for address autocomplete, the route map, and distance-based pricing.
# Enable: Maps JavaScript API, Places API, Directions API.
#
# Client-side key: restrict it by HTTP referrer (your site's domain) in the
# Google Cloud Console. It's safe to expose publicly with that restriction.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
# Server-side key: used to independently re-verify distance/duration before
# charging a card, so a request can't be tampered with to lower the fare.
# Restrict it by IP address (or reuse the same key if you'd rather not
# manage two) — this one must NOT have the NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_key_here
